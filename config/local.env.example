# Optional. Copy to .env.local (ignored by Git); normal local startup needs no env file.
APP_ENV=local
NODE_ENV=development
PORT=4174
BETTER_AUTH_URL=http://127.0.0.1:4174
AUTH_DATA_DIR=.local
EXTERNAL_SERVICE_MODE=local
# Optional strict ownership workflow for synthetic test mail; never sends real email.
# Staging always requires verification. Its private inbox is explicitly Mock only.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
