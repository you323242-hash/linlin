# NOT ready to run: HTTPS proxy and access authentication must be configured first.
APP_ENV=staging
NODE_ENV=production
PORT=4174
BETTER_AUTH_URL=https://preview.example.invalid
AUTH_DATA_DIR=/var/lib/delta-staging
EXTERNAL_SERVICE_MODE=local
ALLOW_STAGING_MOCKS=true
TRUSTED_PROXY_IPS=127.0.0.1
# Two DIFFERENT random secrets, >=32 characters; never commit or paste into chat.
BETTER_AUTH_SECRET=
STAGING_ACCESS_TOKEN=

# Separate backup encryption key file (outside checkout) and original auth key reference.
# Generate locally with scripts/secure-backup.mjs; do not put key contents here.
BACKUP_KEY_FILE=
AUTH_KEY_REF=

# Default preserves restricted mock tests; disabled blocks NEW paid orders/payments.
# Historical fulfillment, refunds and queued work continue. This never opens production.
PAID_ORDERS_MODE=enabled
