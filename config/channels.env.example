# Preparation only. Loaded privately by systemd later; never paste real secrets into chat.
# Merely declaring any file below does NOT activate channels.
LOGIN_CHANNEL_MODE=disabled
AUTH_PHONE_MODE=disabled
# Set AUTH_PHONE_MODE=mock only for operator-controlled synthetic testing; no SMS sent.
PAYMENT_CHANNEL_MODE=mock
# Absolute paths OUTSIDE the repository, files 0600 on Linux. Contents are not yet consumed.
SMS_SECRET_FILE=
WECHAT_LOGIN_SECRET_FILE=
QQ_LOGIN_SECRET_FILE=
PAYMENT_SECRET_FILE=
