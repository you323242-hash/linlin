[Unit]
Description=Delta pending monitor recovery only

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/delta-staging/current
ExecStart=/usr/bin/bash /opt/delta-staging/current/deploy/backup-resume.sh monitor-only
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/delta-maintenance
RestrictAddressFamilies=AF_UNIX
TimeoutStartSec=15s
