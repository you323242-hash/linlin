[Unit]
Description=Delta companion restricted staging
After=network.target

[Service]
Type=simple
User=delta-staging
Group=delta-staging
WorkingDirectory=/opt/delta-staging/current
EnvironmentFile=/etc/delta/staging.env
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/delta-staging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
